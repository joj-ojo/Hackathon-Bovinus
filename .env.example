# Copie para .env e preencha o que tiver.
# Tudo é opcional: sem chave, o sistema roda em modo demo/heurístico.

# --- Banco ---
# Vazio = SQLite local em data/bovinos.db
# Supabase: postgresql+psycopg://postgres:SENHA@db.xxxx.supabase.co:5432/postgres
# DATABASE_URL=

# --- Negócio ---
PRECO_KG=119.0

# --- Visão computacional ---
# auto | gemini | openai | heuristica
VISION_PROVIDER=auto
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Demo ---
SEED_COMANDAS_POR_DIA=180
